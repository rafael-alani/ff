FROM oven/bun:1.3.14 AS bun
FROM node:26.9.0-bookworm-slim
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.33.4
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1 PUPPETEER_SKIP_DOWNLOAD=1 NODE_OPTIONS=--max-old-space-size=8192
COPY --chown=node:node . .
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_APP_URL=https://ff.staging.rafael.media
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
RUN pnpm ff:build && pnpm ff:check && pnpm ff:test
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=1536
USER node
WORKDIR /workspace/apps/v4
EXPOSE 4000
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "4000"]
